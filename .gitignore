# Dependencies
node_modules/

# Next.js build output
.next/
out/

# Test and coverage output
coverage/

# Local environment files
.env
.env.*
!.env.example

# Logs and system files
*.log
.DS_Store

# TypeScript incremental build data
*.tsbuildinfo

# Entorno de Python de la ingesta
.venv/
__pycache__/

# Herramientas compiladas localmente (tippecanoe) y datos crudos de la ingesta
.herramientas/
datos/crudos/

# Teselas generadas por la ingesta (edificios ~57 MB, siniestros); se regeneran con npm run ingesta
public/data/*.pmtiles

# Caché local de teselas de ortofoto (proxy /api/ortofoto)
.cache/
